---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { compareByCategoryOrder } from '../data/menuCategoryOrder';
import { ONLINE_ORDERING_HOURS } from '../utils/order';

const menuItems = await getCollection('menu');

const categories = new Map<string, typeof menuItems>();
for (const item of menuItems) {
	const list = categories.get(item.data.category) ?? [];
	list.push(item);
	categories.set(item.data.category, list);
}

const orderedCategories = [...categories.entries()].sort(([a], [b]) =>
	compareByCategoryOrder(a, b)
);

function formatHour(time: string): string {
	const [h, m] = time.split(':').map(Number);
	const period = h >= 12 ? 'PM' : 'AM';
	const hour12 = h % 12 === 0 ? 12 : h % 12;
	return `${hour12}:${String(m).padStart(2, '0')} ${period}`;
}

const orderingHoursLabel = `${formatHour(ONLINE_ORDERING_HOURS.start)} – ${formatHour(ONLINE_ORDERING_HOURS.end)}`;
---

<Layout
	title="Order"
	description="Place an order from Lavender Refreshments — sent straight to our Facebook Page via Messenger."
>
	<div class="bg-gradient-to-b from-[#fdf2f8] to-[#fffbff]">
		<div class="mx-auto flex max-w-[1160px] flex-col gap-2 px-6 pt-9 pb-6 lg:px-10 lg:pt-14 lg:pb-6">
			<h1 class="m-0 text-[26px] font-extrabold text-brand-950 lg:text-4xl">Place Your Order</h1>
			<p class="max-w-[520px] text-sm leading-relaxed text-brand-700">
				Fill this out and we'll open Messenger with your order ready to send — no payment happens
				here, just a quick message to the Purple House.
			</p>
		</div>
	</div>

	<form id="order-form" novalidate class="mx-auto max-w-[1160px] px-6 pt-2 pb-10 lg:px-10 lg:pb-16">
		<div class="lg:grid lg:grid-cols-[1.4fr_1fr] lg:items-start lg:gap-14">
			<div class="flex flex-col gap-7">
				<!-- Your details -->
				<section class="flex flex-col gap-3.5">
					<h2 class="text-[13px] font-extrabold tracking-[0.08em] text-brand-600 uppercase">Your Details</h2>
					<div class="grid gap-3.5 sm:grid-cols-2">
						<label class="flex flex-col gap-1.5">
							<span class="text-xs font-bold tracking-wide text-brand-800 uppercase">Name</span>
							<input
								type="text"
								id="customer-name"
								name="name"
								required
								placeholder="Juan Dela Cruz"
								class="rounded-xl border-[1.5px] border-brand-100 px-3.5 py-3 text-[15px] text-brand-950"
							/>
						</label>
						<label class="flex flex-col gap-1.5">
							<span class="text-xs font-bold tracking-wide text-brand-800 uppercase">Contact Number</span>
							<input
								type="tel"
								id="customer-contact"
								name="contact"
								required
								inputmode="numeric"
								maxlength="11"
								pattern="09[0-9]{9}"
								placeholder="09171234567"
								class="rounded-xl border-[1.5px] border-brand-100 px-3.5 py-3 text-[15px] text-brand-950"
							/>
							<span class="text-xs text-brand-600">11-digit mobile number starting with 09</span>
						</label>
					</div>
				</section>

				<!-- Your order -->
				<section class="flex flex-col gap-3.5">
					<h2 class="text-[13px] font-extrabold tracking-[0.08em] text-brand-600 uppercase">Your Order</h2>

					<div class="flex flex-col gap-2.5 sm:flex-row">
						<label class="sr-only" for="item-picker">Choose an item to add</label>
						<select
							id="item-picker"
							class="flex-1 rounded-xl border-[1.5px] border-brand-100 px-3.5 py-3 text-[15px] text-brand-950"
						>
							{
								orderedCategories.map(([category, items]) => (
									<optgroup label={category}>
										{items.map((item) => (
											<option value={item.data.id} data-name={item.data.name} data-price={item.data.price}>
												{item.data.name} — {item.data.price === 'Ask staff' ? 'Ask staff' : `₱${item.data.price}`}
											</option>
										))}
									</optgroup>
								))
							}
						</select>
						<button
							type="button"
							id="add-item-btn"
							class="rounded-xl bg-brand-100 px-5 py-3 text-sm font-bold text-brand-700"
							>Add</button
						>
					</div>

					<p id="items-empty" class="text-sm text-brand-700">No items added yet — use the picker above.</p>
					<div id="order-items" class="flex flex-col gap-2.5"></div>
				</section>

				<!-- Fulfillment -->
				<section class="flex flex-col gap-3.5">
					<h2 class="text-[13px] font-extrabold tracking-[0.08em] text-brand-600 uppercase">Pickup or Dine-In</h2>
					<div class="flex gap-2.5" role="group" aria-label="Pickup or dine-in">
						<button
							type="button"
							id="fulfillment-pickup"
							aria-pressed="true"
							class="flex-1 rounded-xl border-[1.5px] border-brand-600 bg-brand-600 py-3 text-sm font-bold text-white"
							>Pickup</button
						>
						<button
							type="button"
							id="fulfillment-dine-in"
							aria-pressed="false"
							class="flex-1 rounded-xl border-[1.5px] border-brand-600 bg-white py-3 text-sm font-bold text-brand-700"
							>Dine-In</button
						>
					</div>
					<input type="hidden" id="fulfillment-value" name="fulfillment" value="Pickup" />
				</section>

				<!-- When -->
				<section class="flex flex-col gap-3.5">
					<h2 class="text-[13px] font-extrabold tracking-[0.08em] text-brand-600 uppercase">When</h2>
					<div class="grid grid-cols-2 gap-3.5 sm:max-w-[360px]">
						<label class="flex flex-col gap-1.5">
							<span class="text-xs font-bold tracking-wide text-brand-800 uppercase">Date</span>
							<input
								type="date"
								id="order-date"
								name="date"
								class="rounded-xl border-[1.5px] border-brand-100 px-3.5 py-3 text-[15px] text-brand-950"
							/>
						</label>
						<label class="flex flex-col gap-1.5">
							<span class="text-xs font-bold tracking-wide text-brand-800 uppercase">Time</span>
							<input
								type="time"
								id="order-time"
								name="time"
								min={ONLINE_ORDERING_HOURS.start}
								max={ONLINE_ORDERING_HOURS.end}
								class="rounded-xl border-[1.5px] border-brand-100 px-3.5 py-3 text-[15px] text-brand-950"
							/>
						</label>
					</div>
					<p class="text-xs text-brand-600">Online orders for pickup/dine-in are prepped {orderingHoursLabel}.</p>
				</section>

				<!-- Notes -->
				<label class="flex flex-col gap-1.5">
					<span class="text-xs font-bold tracking-wide text-brand-800 uppercase">Notes (optional)</span>
					<textarea
						id="order-notes"
						name="notes"
						rows="3"
						placeholder="Allergies, extra requests, etc."
						class="rounded-xl border-[1.5px] border-brand-100 px-3.5 py-3 text-[15px] text-brand-950"
					></textarea>
				</label>
			</div>

			<!-- Summary panel -->
			<div class="mt-8 flex flex-col gap-4 rounded-[20px] border border-brand-50 bg-brand-50 p-6 lg:sticky lg:top-6 lg:mt-0">
				<h2 class="text-[13px] font-extrabold tracking-[0.08em] text-brand-600 uppercase">Order Summary</h2>
				<div id="summary-empty" class="text-sm text-brand-700">Your items will show up here.</div>
				<div id="summary-lines" class="hidden flex-col gap-2 text-[13.5px] text-brand-900"></div>
				<div id="summary-total" class="hidden justify-between border-t border-brand-200 pt-3 text-[15px] font-extrabold text-brand-950"></div>

				<p id="form-error" role="alert" class="hidden text-sm font-semibold text-red-600"></p>

				<button
					type="submit"
					class="mt-1 flex items-center justify-center gap-2.5 rounded-2xl bg-brand-600 py-4 text-[15.5px] font-extrabold text-white"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="#ffffff"
						><path
							d="M12 2C6.48 2 2 6.15 2 11.27c0 2.91 1.44 5.5 3.7 7.2V22l3.38-1.86c.9.25 1.87.38 2.92.38 5.52 0 10-4.15 10-9.25S17.52 2 12 2zm1.02 12.46l-2.55-2.72-4.98 2.72 5.48-5.82 2.6 2.72 4.93-2.72-5.48 5.82z"
						></path></svg
					>
					Send Order via Messenger
				</button>
				<p class="text-center text-xs text-brand-600">Opens Messenger with your order pre-filled — you tap send</p>
			</div>
		</div>
	</form>
</Layout>

<script define:vars={{ facebookPageId: site.facebookPageId, orderingHoursLabel }}>
	window.__ORDER_CONFIG__ = { facebookPageId, orderingHoursLabel };
</script>

<script>
	import {
		buildMessengerLink,
		buildOrderMessage,
		isValidLocalMobileNumber,
		isWithinOnlineOrderingHours,
		normalizeLocalMobileNumber,
	} from '../utils/order.ts';

	const { facebookPageId, orderingHoursLabel } = window.__ORDER_CONFIG__;

	/** @type {{ id: string; name: string; price: number | 'Ask staff'; quantity: number }[]} */
	let cart = [];

	const itemPicker = document.getElementById('item-picker');
	const addItemBtn = document.getElementById('add-item-btn');
	const orderItemsEl = document.getElementById('order-items');
	const itemsEmptyEl = document.getElementById('items-empty');

	const summaryEmptyEl = document.getElementById('summary-empty');
	const summaryLinesEl = document.getElementById('summary-lines');
	const summaryTotalEl = document.getElementById('summary-total');

	const pickupBtn = document.getElementById('fulfillment-pickup');
	const dineInBtn = document.getElementById('fulfillment-dine-in');
	const fulfillmentValue = document.getElementById('fulfillment-value');

	const formErrorEl = document.getElementById('form-error');
	const form = document.getElementById('order-form');

	function priceLabel(price) {
		return price === 'Ask staff' ? 'Ask staff' : `₱${price}`;
	}

	function renderItems() {
		orderItemsEl.innerHTML = '';
		itemsEmptyEl.classList.toggle('hidden', cart.length > 0);

		for (const item of cart) {
			const row = document.createElement('div');
			row.className =
				'flex items-center gap-3 rounded-xl border-[1.5px] border-brand-100 px-3.5 py-3';
			row.innerHTML = `
				<div class="flex-1">
					<div class="text-sm font-bold text-brand-950">${item.name}</div>
					<div class="text-xs font-bold text-brand-600">${priceLabel(item.price)}</div>
				</div>
				<div class="flex items-center gap-2.5">
					<button type="button" data-action="decrement" data-id="${item.id}" aria-label="Decrease quantity of ${item.name}"
						class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-50 font-bold text-brand-700">&minus;</button>
					<span class="min-w-[16px] text-center font-bold text-brand-950">${item.quantity}</span>
					<button type="button" data-action="increment" data-id="${item.id}" aria-label="Increase quantity of ${item.name}"
						class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-600 font-bold text-white">+</button>
					<button type="button" data-action="remove" data-id="${item.id}" aria-label="Remove ${item.name}"
						class="ml-1 text-xs font-bold text-red-500">Remove</button>
				</div>
			`;
			orderItemsEl.appendChild(row);
		}

		renderSummary();
	}

	function renderSummary() {
		if (cart.length === 0) {
			summaryEmptyEl.classList.remove('hidden');
			summaryLinesEl.classList.add('hidden');
			summaryTotalEl.classList.add('hidden');
			summaryLinesEl.classList.remove('flex');
			summaryTotalEl.classList.remove('flex');
			return;
		}

		summaryEmptyEl.classList.add('hidden');
		summaryLinesEl.classList.remove('hidden');
		summaryLinesEl.classList.add('flex');
		summaryTotalEl.classList.remove('hidden');
		summaryTotalEl.classList.add('flex');

		summaryLinesEl.innerHTML = cart
			.map(
				(item) => `
				<div class="flex justify-between">
					<span>${item.quantity}&times; ${item.name}</span>
					<span class="font-bold">${item.price === 'Ask staff' ? 'Ask staff' : `₱${item.price * item.quantity}`}</span>
				</div>`
			)
			.join('');

		const total = cart.reduce((sum, item) => (item.price === 'Ask staff' ? sum : sum + item.price * item.quantity), 0);
		const hasAskStaff = cart.some((item) => item.price === 'Ask staff');
		summaryTotalEl.innerHTML = `<span>Total</span><span>₱${total}${hasAskStaff ? ' +' : ''}</span>`;
	}

	addItemBtn.addEventListener('click', () => {
		const option = itemPicker.selectedOptions[0];
		if (!option) return;

		const id = option.value;
		const name = option.dataset.name;
		const rawPrice = option.dataset.price;
		const price = rawPrice === 'Ask staff' ? 'Ask staff' : Number(rawPrice);

		const existing = cart.find((item) => item.id === id);
		if (existing) {
			existing.quantity += 1;
		} else {
			cart.push({ id, name, price, quantity: 1 });
		}
		renderItems();
	});

	orderItemsEl.addEventListener('click', (event) => {
		const button = event.target.closest('button[data-action]');
		if (!button) return;
		const id = button.dataset.id;
		const action = button.dataset.action;

		if (action === 'remove') {
			cart = cart.filter((item) => item.id !== id);
		} else {
			const item = cart.find((entry) => entry.id === id);
			if (!item) return;
			if (action === 'increment') item.quantity += 1;
			if (action === 'decrement') {
				item.quantity -= 1;
				if (item.quantity <= 0) cart = cart.filter((entry) => entry.id !== id);
			}
		}
		renderItems();
	});

	function setFulfillment(value) {
		fulfillmentValue.value = value;
		const isDineIn = value === 'Dine-in';

		pickupBtn.setAttribute('aria-pressed', String(!isDineIn));
		dineInBtn.setAttribute('aria-pressed', String(isDineIn));
		pickupBtn.classList.toggle('bg-brand-600', !isDineIn);
		pickupBtn.classList.toggle('text-white', !isDineIn);
		pickupBtn.classList.toggle('bg-white', isDineIn);
		pickupBtn.classList.toggle('text-brand-700', isDineIn);
		dineInBtn.classList.toggle('bg-brand-600', isDineIn);
		dineInBtn.classList.toggle('text-white', isDineIn);
		dineInBtn.classList.toggle('bg-white', !isDineIn);
		dineInBtn.classList.toggle('text-brand-700', !isDineIn);
	}

	pickupBtn.addEventListener('click', () => setFulfillment('Pickup'));
	dineInBtn.addEventListener('click', () => setFulfillment('Dine-in'));

	function showError(message) {
		formErrorEl.textContent = message;
		formErrorEl.classList.remove('hidden');
	}

	function clearError() {
		formErrorEl.classList.add('hidden');
		formErrorEl.textContent = '';
	}

	form.addEventListener('submit', (event) => {
		event.preventDefault();
		clearError();

		const name = document.getElementById('customer-name').value.trim();
		const contact = document.getElementById('customer-contact').value.trim();
		const fulfillment = fulfillmentValue.value;
		const date = document.getElementById('order-date').value;
		const time = document.getElementById('order-time').value;
		const notes = document.getElementById('order-notes').value.trim();

		if (!name || !contact) {
			showError('Please fill in your name and contact number.');
			return;
		}
		if (!isValidLocalMobileNumber(contact)) {
			showError('Please enter an 11-digit mobile number starting with 09, e.g. 09171234567.');
			return;
		}
		if (cart.length === 0) {
			showError('Please add at least one item to your order.');
			return;
		}
		if (!isWithinOnlineOrderingHours(time)) {
			showError(`Please pick a time between ${orderingHoursLabel} so we can prep your order.`);
			return;
		}

		const message = buildOrderMessage({
			name,
			contact: normalizeLocalMobileNumber(contact),
			items: cart,
			fulfillment,
			date,
			time,
			notes,
		});

		window.location.href = buildMessengerLink(facebookPageId, message);
	});
</script>
