---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { getPhoto } from '../utils/photos';
import { mapsUrl, site } from '../data/site';

const heroPhoto = getPhoto('hero-exterior.jpg');
const dineInPhoto = getPhoto('dine-in.jpg');

const features = [
	{
		title: 'Authentic Filipino Home Cooking',
		body: 'From sizzling sisig to comforting batchoy, every dish is made with love, just like home.',
		iconPaths: ['M4 12h16', 'M4 12a8 8 0 0 0 16 0', 'M4 12c0-4 2-7 3-9', 'M17 3c1 2 3 5 3 9'],
	},
	{
		title: 'Dine-In, All Purple Everything',
		body: 'Step into a world of purple furniture, purple decor, and a cozy vibe that makes you want to stay a little longer.',
		iconPaths: ['M20.8 8.6c0 5.4-8.8 10.6-8.8 10.6S3.2 14 3.2 8.6a4.6 4.6 0 0 1 8.8-1.9 4.6 4.6 0 0 1 8.8 1.9z'],
	},
	{
		title: 'A Place to Unwind & Relax',
		body: 'More than a restaurant — your safe space to slow down, eat well, and feel at peace.',
		iconPaths: ['M12 22c4-3 8-6.5 8-11.5S16 2 12 2 4 5.5 4 10.5 8 19 12 22z', 'M12 8v6'],
	},
];
---

<Layout
	title="Home"
	description="A warm Filipino restaurant and relaxing retreat inside the iconic Purple House in Culasi, Ajuy, Iloilo."
>
	<!-- Hero -->
	<div class="bg-gradient-to-b from-[#fdf2f8] to-brand-100">
		<div class="mx-auto flex max-w-[720px] flex-col items-center gap-5 px-6 py-12 text-center lg:max-w-[1160px] lg:py-20">
			<div class="text-xs font-bold tracking-[0.14em] text-brand-600 uppercase">
				Lavender Refreshments at the Purple House
			</div>
			<h1 class="m-0 text-[34px] leading-tight font-extrabold text-brand-950 lg:text-[48px]">
				Where Every <span class="font-bold text-brand-600 italic">Petal</span> Tells a Story
			</h1>
			<p class="max-w-[340px] text-[15px] leading-relaxed text-brand-800 lg:max-w-[440px] lg:text-[16.5px]">
				A warm Filipino restaurant and relaxing retreat inside the iconic Purple House. Where good
				food, good vibes, and a home away from home await you.
			</p>
			<div class="flex w-full max-w-[300px] flex-col gap-3 pt-2 sm:w-auto sm:max-w-none sm:flex-row sm:justify-center">
				<a
					href="/menu"
					class="rounded-2xl bg-brand-600 px-7 py-4 text-[15px] font-bold whitespace-nowrap text-white"
					>Explore Our Menu</a
				>
				<a
					href="/order"
					class="rounded-2xl border-[1.5px] border-brand-600 px-7 py-4 text-[15px] font-bold whitespace-nowrap text-brand-700"
					>Order Now</a
				>
			</div>
		</div>
	</div>

	<Image
		src={heroPhoto}
		alt="The Purple House exterior seating area with the Lavender Refreshment sign"
		width={1400}
		height={560}
		class="h-[280px] w-full object-cover lg:h-[420px]"
	/>

	<!-- Quick info strip -->
	<div class="border-b border-brand-50 bg-white">
		<div
			class="mx-auto grid max-w-[1160px] gap-3.5 px-5 py-7 lg:grid-cols-3 lg:gap-10 lg:px-10 lg:py-9"
		>
			<div class="flex items-center gap-3.5">
				<div class="flex h-[38px] w-[38px] flex-shrink-0 items-center justify-center rounded-[10px] bg-brand-50">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
						><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 3"></path></svg
					>
				</div>
				<div>
					<div class="text-sm font-bold text-brand-950">{site.hours}</div>
				</div>
			</div>
			<div class="flex items-center gap-3.5">
				<div class="flex h-[38px] w-[38px] flex-shrink-0 items-center justify-center rounded-[10px] bg-brand-50">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
						><path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z"></path><circle
							cx="12"
							cy="10"
							r="2.5"></circle></svg
					>
				</div>
				<a href={mapsUrl} target="_blank" rel="noreferrer" class="text-sm font-semibold text-brand-900 hover:text-brand-600"
					>{site.address}</a
				>
			</div>
			<div class="flex items-center gap-3.5">
				<div class="flex h-[38px] w-[38px] flex-shrink-0 items-center justify-center rounded-[10px] bg-brand-50">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="#7c3aed"
						><path
							d="M12 2C6.48 2 2 6.15 2 11.27c0 2.91 1.44 5.5 3.7 7.2V22l3.38-1.86c.9.25 1.87.38 2.92.38 5.52 0 10-4.15 10-9.25S17.52 2 12 2zm1.02 12.46l-2.55-2.72-4.98 2.72 5.48-5.82 2.6 2.72 4.93-2.72-5.48 5.82z"
						></path></svg
					>
				</div>
				<a href={site.facebookUrl ?? '#'} class="text-sm font-semibold">Lavender refreshment on Facebook</a>
			</div>
		</div>
	</div>

	<!-- Feature intro -->
	<div class="mx-auto flex max-w-[1160px] flex-col gap-6 px-6 py-9 lg:grid lg:grid-cols-3 lg:gap-12 lg:px-10 lg:py-16">
		{
			features.map((feature) => (
				<div class="flex items-start gap-4">
					<svg
						width="26"
						height="26"
						viewBox="0 0 24 24"
						fill="none"
						stroke="#7c3aed"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="mt-0.5 flex-shrink-0 lg:h-[30px] lg:w-[30px]"
					>
						{feature.iconPaths.map((d) => (
							<path d={d} />
						))}
					</svg>
					<div>
						<div class="text-[15px] font-bold text-brand-950 lg:text-[16.5px]">{feature.title}</div>
						<div class="mt-0.5 text-[13.5px] leading-relaxed text-brand-800 lg:text-sm">
							{feature.body}
						</div>
					</div>
				</div>
			))
		}
	</div>

	<!-- Second photo + closing CTA -->
	<Image
		src={dineInPhoto}
		alt="Guests relaxing in the purple seating area at the Purple House"
		width={1400}
		height={480}
		class="h-[240px] w-full object-cover lg:hidden"
	/>
	<div class="bg-brand-50">
		<div
			class="mx-auto flex max-w-[1160px] flex-col items-center gap-4 px-6 py-9 text-center lg:grid lg:grid-cols-2 lg:items-center lg:gap-16 lg:px-10 lg:py-18 lg:text-left"
		>
			<Image
				src={dineInPhoto}
				alt="Guests relaxing in the purple seating area at the Purple House"
				width={800}
				height={480}
				class="hidden h-[360px] w-full rounded-3xl object-cover lg:block"
			/>
			<div class="flex flex-col items-center gap-4 lg:items-start">
				<div class="text-[19px] font-extrabold text-brand-950 lg:text-[28px]">Ready to visit?</div>
				<p class="max-w-[280px] text-sm leading-relaxed text-brand-700 lg:max-w-[380px] lg:text-[15px]">
					Order ahead for pickup, or just walk in — we'll have a purple seat waiting.
				</p>
				<a href="/order" class="rounded-2xl bg-brand-600 px-7 py-3.5 text-[15px] font-bold text-white"
					>Order Now</a
				>
			</div>
		</div>
	</div>
</Layout>
