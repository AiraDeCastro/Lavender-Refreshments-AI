---
interface Props {
	price: number | 'Ask staff';
}

const { price } = Astro.props;
---

{
	price === 'Ask staff' ? (
		<span class="w-fit rounded-full bg-brand-100 px-2.5 py-1 text-[11.5px] font-bold whitespace-nowrap text-brand-800">
			Ask staff
		</span>
	) : (
		<div class="pt-0.5 text-[15px] font-extrabold whitespace-nowrap text-brand-600">₱{price}</div>
	)
}
