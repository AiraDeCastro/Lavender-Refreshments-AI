---
import { Image } from 'astro:assets';
import { getPhoto } from '../utils/photos';

interface Props {
	name: string;
	position: string;
	photo?: string;
}

const { name, position, photo } = Astro.props;
const photoAsset = photo ? getPhoto(photo) : null;

const initials = name
	.split(' ')
	.map((part) => part[0])
	.slice(0, 2)
	.join('')
	.toUpperCase();
---

<div class="flex flex-col items-center gap-2.5 text-center">
	{
		photoAsset ? (
			<Image
				src={photoAsset}
				alt={name}
				width={200}
				height={200}
				densities={[1, 2, 3]}
				class="h-[130px] w-[130px] rounded-full object-cover lg:h-[170px] lg:w-[170px]"
			/>
		) : (
			<div class="flex h-[130px] w-[130px] items-center justify-center rounded-full bg-brand-100 text-3xl font-extrabold text-brand-700 lg:h-[170px] lg:w-[170px] lg:text-4xl">
				{initials}
			</div>
		)
	}
	<div class="flex flex-col gap-0.5">
		<div class="text-sm font-bold text-brand-950">{name}</div>
		<div class="text-xs font-semibold text-brand-600">{position}</div>
	</div>
</div>
